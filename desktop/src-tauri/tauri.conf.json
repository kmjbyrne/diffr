{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diffr",
  "version": "0.1.0",
  "identifier": "dev.diffr.app",
  "build": {
    "beforeDevCommand": "uv run diffr --no-open &",
    "devUrl": "http://127.0.0.1:8787",
    "beforeBuildCommand": "",
    "frontendDist": "http://127.0.0.1:8787"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "diffr",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
